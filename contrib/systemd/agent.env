# Required: URL of the SECentral ingestion endpoint.
SECENTRAL_ENDPOINT=

# Required: ingestion key issued by the SECentral server.
SECENTRAL_INGESTION_KEY=

# Optional: local spool directory (default: /var/lib/secentral/spool).
# SECENTRAL_SPOOL=/var/lib/secentral/spool

# Optional: enable structured debug logging (default: false).
# SECENTRAL_DEBUG=false
