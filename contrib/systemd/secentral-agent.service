[Unit]
Description=SECentral SELinux audit agent
After=network-online.target auditd.service
Wants=network-online.target

[Service]
Type=simple
User=root
EnvironmentFile=/etc/secentral/agent.env
ExecStart=/usr/local/bin/secentral-agent
Restart=on-failure
RestartSec=5s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/secentral
ReadWritePaths=/var/lib/selinux/targeted/semanage.read.LOCK
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
RestrictNamespaces=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=multi-user.target
